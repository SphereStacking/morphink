{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "singleAttributePerLine": false,
  "sortImports": {},
  "sortPackageJson": {},
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles/tailwind.css",
    "functions": ["cn", "cva"],
    "attributes": [":class"]
  }
}
