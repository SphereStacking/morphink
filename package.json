{
  "name": "ink-ui",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:css": "pnpm --filter @ink-ui/tokens build && pnpm --filter @ink-ui/ui build:css",
    "build:docs": "pnpm --filter @ink-ui/docs build",
    "dev": "pnpm -r dev",
    "dev:docs": "pnpm --filter @ink-ui/docs dev",
    "lint": "eslint 'packages/*/src/**/*.{ts,vue}'",
    "format": "prettier --write 'packages/*/src/**/*.{ts,vue,css,json}'",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
