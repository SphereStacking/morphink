{
  "name": "ink-ui",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:css": "pnpm --filter @ink-ui/tokens build && pnpm --filter @ink-ui/ui build:css",
    "build:docs": "pnpm --filter @ink-ui/docs build",
    "dev": "pnpm -r dev",
    "dev:docs": "pnpm --filter @ink-ui/docs dev",
    "lint": "oxlint packages/",
    "format": "oxfmt --write packages/",
    "format:check": "oxfmt --check packages/",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "oxlint": "^1.49.0",
    "oxfmt": "^0.35.0",
    "typescript": "^5.7.0"
  }
}
