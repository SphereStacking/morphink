{
  "name": "morphink",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:docs": "pnpm --filter @morphink/tokens build && pnpm --filter @morphink/ui build && pnpm --filter @morphink/docs dev",
    "lint": "oxlint packages/",
    "format": "oxfmt --write packages/",
    "format:check": "oxfmt --check packages/",
    "test": "pnpm --filter @morphink/ui test"
  },
  "devDependencies": {
    "oxlint": "^1.49.0",
    "oxfmt": "^0.35.0",
    "typescript": "^5.7.0"
  }
}
