{
  "name": "@morphink/ui",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./src/index.ts"
    },
    "./source": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/ui.css": "./dist/ui.css"
  },
  "scripts": {
    "build": "pnpm run build:css && pnpm run build:js && pnpm run build:types",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./dist/ui.css && node scripts/scope-css.mjs",
    "build:js": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json --noCheck",
    "dev": "echo \"UI dev not configured yet\"",
    "lint": "echo \"Lint runs at root level\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "figma:publish": "figma connect publish"
  },
  "dependencies": {
    "@morphink/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.8.2",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.3",
    "@tailwindcss/cli": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue": "^3.4.0",
    "vue-tsc": "^3.2.5"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
