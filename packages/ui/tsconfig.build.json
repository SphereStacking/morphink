{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/__tests__/**"]
}
